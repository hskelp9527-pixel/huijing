{
  "name": "loomic",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "test:workspace": "node --test tests/*.test.mjs",
    "test:packages": "turbo run test",
    "test": "pnpm run test:workspace && pnpm run test:packages",
    "typecheck": "turbo run typecheck",
    "dev:edge": "pnpm --filter @loomic/shared build && pnpm --filter @loomic/edge dev",
    "test:edge": "pnpm --filter @loomic/shared build && pnpm --filter @loomic/edge test",
    "build:edge": "pnpm --filter @loomic/shared build && pnpm --filter @loomic/edge build",
    "deploy:dry-run": "node scripts/deploy.mjs --dry-run"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
