# 部署工具输入；进程环境或本机私有文件，不能提交真实值。
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-token
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
VERTEX_API_KEY=replace-with-vertex-api-key
SESSION_SECRET=replace-with-random-session-secret-at-least-32-characters
# 可选私有文件输入，无任何本机默认路径：
# CLOUDFLARE_ENV_FILE=/absolute/path/to/private-cloudflare.env
# VERTEX_KEY_FILE=/absolute/path/to/private-vertex-key.md
# DEPLOY_BASE_URL=https://huijing.your-subdomain.workers.dev
GUEST_DAILY_IMAGES=10
GLOBAL_DAILY_IMAGES=150
GUEST_DAILY_RUNS=30
QUOTA_CLIENT_OPS_DAILY=100
# HTTP(S)_PROXY 仅由本地开发者按需在启动环境设置。
